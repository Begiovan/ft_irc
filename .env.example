# Porta dentro al container.
IRC_PORT=6667

# Porta esposta sul Raspberry/router.
IRC_EXTERNAL_PORT=6667

# Cambiala sul Raspberry in .env: non committare la password reale.
IRC_PASS=change-me-strong-password

# Token ngrok per esporre il tunnel TCP pubblico. Non committare il valore reale.
NGROK_AUTHTOKEN=change-me-ngrok-token
